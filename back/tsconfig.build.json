{
  "extends": "./tsconfig.json",
  /*
   * Configuración con la que compila el SERVIDOR (`nest build` y
   * `nest start --watch`). La diferencia con `tsconfig.json` es una sola cosa:
   * aquí no entran los tests.
   *
   * Sin este archivo, la CLI de Nest compilaba con `tsconfig.json`, que incluye
   * los `.spec.ts`. Un test a medio escribir —un import sin terminar— rompía la
   * compilación del servidor, y como `--watch` conserva el último build bueno,
   * el backend seguía respondiendo con código viejo sin avisar de nada. Se
   * pierde media hora buscando por qué un cambio "no se aplica".
   *
   * Los tests se siguen comprobando: `jest` usa ts-jest contra `tsconfig.json`,
   * así que un error de tipos en un spec falla en `npm test`, que es donde debe
   * fallar.
   */
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*.spec.ts", "**/*.e2e-spec.ts"]
}
